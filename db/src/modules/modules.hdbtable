COLUMN TABLE "modules" (
    "id" BIGINT GENERATED BY DEFAULT AS IDENTITY,

    "module" BIGINT UNIQUE NOT NULL,
    
    "header" NVARCHAR(50),
    "subheader" NVARCHAR(100),
    
    "contentType" NVARCHAR(100), --icon / src / contentText
    "content" NVARCHAR(1000),
    
    "footer" NVARCHAR(100),
    "route" NVARCHAR(100) NOT NULL,
    "status" INTEGER NOT NULL,
    PRIMARY KEY ("id")
)