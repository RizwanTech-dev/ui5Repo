<core:FragmentDefinition xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <Dialog title="Select Handover Notice" contentWidth="60%" contentHeight="80%">
        <content>
            <ScrollContainer height="100%" width="100%" horizontal="true" vertical="true">
                <FlexBox direction="Column" renderType="Div" class="sapUiSmallMargin" fitContainer="true">
                    <FlexBox>
                        <Button text="Correctly Displayed" press="onCorrectPathClick"/>
                        <Button text="Loading Error" press="onIncorrectPathClick"/>
                    </FlexBox>
                    <PDFViewer source="{/Source}" isTrustedSource="true" title="{/Title}" height="600px">
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </PDFViewer>
                </FlexBox>
            </ScrollContainer>
        </content>
    </Dialog>
</core:FragmentDefinition>