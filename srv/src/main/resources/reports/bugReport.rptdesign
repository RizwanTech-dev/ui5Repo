            <method name="open"><![CDATA[importPackage(Packages.java.util);

var reportData = reportContext.getAppContext().get("inputObject");
var list = null;

if (reportData != null) {
    if (typeof reportData.get === "function") {
        list = reportData.get("bugDetails");
    }
    if (list == null && reportData["bugDetails"] != null) {
        list = reportData["bugDetails"];
    }
}

iterator = null;
if (list != null) {
    if (list.iterator) {
        iterator = list.iterator();
    } else if (list.length !== undefined) {
        var idx = 0;
        iterator = {
            hasNext: function() { return idx < list.length; },
            next: function() { return list[idx++]; }
        };
    }
}

if (iterator == null) {
    iterator = java.util.Collections.emptyIterator();
}]]></method>
            <method name="fetch"><![CDATA[if (iterator != null && iterator.hasNext()) {
    var item = iterator.next();

    var itemId = "";
    var itemImage = "";
    var itemDesc = "";

    if (item != null) {
        if (typeof item.getId === "function") {
            itemId = item.getId();
        } else if (typeof item.get === "function") {
            itemId = item.get("id");
        } else if (item.id !== undefined) {
            itemId = item.id;
        } else if (item["id"] !== undefined) {
            itemId = item["id"];
        }

        if (typeof item.getImage === "function") {
            itemImage = item.getImage();
        } else if (typeof item.get === "function") {
            itemImage = item.get("image");
        } else if (item.image !== undefined) {
            itemImage = item.image;
        } else if (item["image"] !== undefined) {
            itemImage = item["image"];
        }

        if (typeof item.getDescription === "function") {
            itemDesc = item.getDescription();
        } else if (typeof item.get === "function") {
            itemDesc = item.get("description");
        } else if (item.description !== undefined) {
            itemDesc = item.description;
        } else if (item["description"] !== undefined) {
            itemDesc = item["description"];
        }
    }

    row['id'] = (itemId != null) ? String(itemId) : "";
    row['image'] = (itemImage != null) ? String(itemImage) : "";
    row['description'] = (itemDesc != null) ? String(itemDesc) : "";

    return true;
} else {
    return false;
}]]></method>
